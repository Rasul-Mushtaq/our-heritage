# API keys (optional)
# Google Places API key for LIVE Google Maps reviews (STEP 1).
# Without it, the pipeline uses a rich bilingual mock corpus automatically.
GOOGLE_PLACES_API_KEY=

# LLM provider for sentiment & issue classification (STEP 2): auto | gemini | openai
# With no key, the built-in offline bilingual classifier is used.
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini
